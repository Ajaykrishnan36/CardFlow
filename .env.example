# ==============================================================================
# CARDFLOW ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
#
# IMPORTANT SECURITY NOTICE:
# - NEVER commit real credentials or production keys to version control.
# - NEVER embed SERVER SECRETS or PRIVATE KEYS into the React Native mobile app bundle.
#
# ==============================================================================

# ==============================================================================
# 1. SERVER CONFIGURATION
# ==============================================================================
PORT=8080
ENV=development                                # development | staging | production
API_BASE_URL=http://localhost:8080/api/v1
PUBLIC_WEB_URL=https://cardflow.app
ALLOWED_ORIGINS=https://cardflow.app,cardflow://

# Database Configuration (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=cardflow_app
DB_NAME=cardflow_db
DB_SSL_MODE=disable                            # disable for local dev, require for prod
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m

# Cache Configuration (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Object Storage Configuration (S3-Compatible)
S3_ENDPOINT=http://localhost:9000              # e.g., http://localhost:9000 (MinIO) or s3.asia-south1.amazonaws.com
S3_REGION=asia-south1
S3_PRIVATE_BUCKET=cardflow-private-media
S3_PUBLIC_BUCKET=cardflow-public-media
S3_USE_SSL=false                               # false for local MinIO, true for AWS S3/R2
S3_PUBLIC_CDN_URL=https://cdn.cardflow.app

# ==============================================================================
# 2. SERVER SECRETS (CRITICAL - BACKEND ONLY, NEVER EXPOSE TO MOBILE)
# ==============================================================================
# Database & Redis Passwords
DB_PASSWORD=your_super_secret_db_password      # [SECRET]
REDIS_PASSWORD=your_redis_password             # [SECRET]

# JWT Cryptographic Keys (Ed25519 or RS256)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----" # [SECRET]
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_ISSUER=cardflow.app
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=30

# Symmetric Encryption Keys (AES-256 for PAN and Sensitive KYC Storage)
DATA_ENCRYPTION_KEY=32_byte_hex_encoded_secret_key_for_aes_gcm # [SECRET]

# S3 Access Credentials
S3_ACCESS_KEY_ID=your_s3_access_key            # [SECRET]
S3_SECRET_ACCESS_KEY=your_s3_secret_key        # [SECRET]

# ==============================================================================
# 3. THIRD-PARTY BACKEND SERVICES (SERVER SECRETS)
# ==============================================================================
# Google Cloud Platform & Vertex AI (Gemini Flash-Lite)
GCP_PROJECT_ID=cardflow-prod-12345
GCP_LOCATION=asia-south1                       # Region for Vertex AI
GCP_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}' # [SECRET]
GEMINI_MODEL_ID=gemini-3.0-flash-lite

# Telephony & SMS Gateway (MSG91 / Kaleyra / Twilio)
SMS_PROVIDER=msg91                             # mock | msg91 | kaleyra | twilio
SMS_AUTH_KEY=your_sms_gateway_auth_key         # [SECRET]
SMS_SENDER_ID=CRDFLW
SMS_OTP_TEMPLATE_ID=1207161234567890123

# KYC Aggregator (Sandbox / Setu / IDfy / Surepass)
KYC_PROVIDER=sandbox                           # mock | sandbox | setu | idfy
KYC_API_KEY=your_kyc_aggregator_api_key        # [SECRET]
KYC_API_SECRET=your_kyc_aggregator_api_secret  # [SECRET]
KYC_BASE_URL=https://api.sandbox.co.in

# In-App Purchase Server Validation (Google Play & Apple)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='{"type": "service_account", ...}' # [SECRET]
GOOGLE_PLAY_PACKAGE_NAME=com.cardflow.app

APPLE_KEY_ID=2X9R4HXF34
APPLE_ISSUER_ID=57f30202-e253-4232-b01a-250e3c66e0a2
APPLE_BUNDLE_ID=com.cardflow.app
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----" # [SECRET]

# Push Notifications (Firebase Cloud Messaging & APNs)
FCM_SERVER_KEY=your_fcm_service_account_or_key # [SECRET]

# ==============================================================================
# 4. MOBILE PUBLIC CONFIGURATION (SAFE TO EMBED IN REACT NATIVE)
# ==============================================================================
# NOTE: These values are compiled into the client app and are publicly readable.
MOBILE_API_BASE_URL=https://api.cardflow.app/api/v1
MOBILE_GOOGLE_MAPS_API_KEY_ANDROID=AIzaSy...public_android_key
MOBILE_GOOGLE_MAPS_API_KEY_IOS=AIzaSy...public_ios_key
MOBILE_PUBLIC_WEB_URL=https://cardflow.app
MOBILE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ==============================================================================
# 5. DEVELOPMENT ENVIRONMENT SPECIFIC (LOCAL DEFAULTS)
# ==============================================================================
# For local dev without third-party services:
DEV_MOCK_SMS=true                              # Logs OTP to backend stdout instead of sending SMS
DEV_MOCK_KYC=true                              # Simulates instant GSTIN/Aadhaar success
DEV_MOCK_GEMINI=false                          # Set true to return mock OCR JSON without Vertex AI
